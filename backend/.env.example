# Renomeie este arquivo para .env e ajuste os valores

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=pizzaria_db
DB_PORT=3306
DB_SSL=false
# Ao usar um banco gratuito hospedado (ex: TiDB Cloud), troque DB_HOST/DB_PORT
# pelos dados fornecidos por eles e coloque DB_SSL=true

PORT=3000

# URLs do(s) site(s) que podem chamar essa API, separadas por vírgula, sem
# barra no final. Ex: https://minhapizzaria.com,https://www.minhapizzaria.com
# OBRIGATÓRIO em produção: sem isso o servidor não inicia. Em branco, só
# funciona em desenvolvimento (libera qualquer origem).
FRONTEND_ORIGINS=

# OBRIGATÓRIO em produção: 32+ caracteres aleatórios (o servidor recusa subir
# com um valor curto ou igual a este exemplo). Para gerar um:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_esta_chave_por_algo_seguro

# Código de instalação: só é usado para criar o PRIMEIRO administrador (banco
# sem nenhum usuário). Defina 16+ caracteres aleatórios, use uma vez e depois
# pode remover a variável. Enviado no header "x-setup-token" do /api/auth/cadastrar.
SETUP_TOKEN=
